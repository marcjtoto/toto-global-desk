---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ClaimLabel from '../../../components/ClaimLabel.astro';
import SourceCard from '../../../components/SourceCard.astro';
import { t } from '../../../i18n/ui';
import { langFromParam, localize } from '../../../lib/lang';
import { EDITION_001_KEYS, storiesFor, storySlug } from '../../../lib/content';

export async function getStaticPaths() {
  const stories = await storiesFor('en');
  const pt = await storiesFor('pt-br');
  return [...stories, ...pt].map((story) => ({
    params: { lang: story.data.lang, slug: storySlug(story) },
    props: { story },
  }));
}

const lang = langFromParam(Astro.params.lang);
const { story } = Astro.props;
const copy = t(lang);
const { Content } = await render(story);
const related = (await storiesFor(lang))
  .filter(
    (s) =>
      s.id !== story.id &&
      s.data.sample === false &&
      (EDITION_001_KEYS as readonly string[]).includes(s.data.translationKey),
  )
  .slice(0, 5);
---

<BaseLayout lang={lang} title={story.data.title} description={story.data.dek} ogType="article">
  <div class="wrap story-shell">
    <article data-pagefind-body>
      <header class="story-header">
        <p class="kicker">
          {story.data.kicker} · {copy[story.data.desk]}
        </p>
        <h1>{story.data.title}</h1>
        <p class="dek">{story.data.dek}</p>
        <p class="byline">
          {copy.authors} {story.data.authors.join(', ')}
          {' · '}
          {copy.published} {story.data.published.toISOString().slice(0, 16).replace('T', ' ')} UTC
          {story.data.updated
            ? ` · ${copy.updated} ${story.data.updated.toISOString().slice(0, 16).replace('T', ' ')} UTC`
            : ''}
        </p>
        <p class="tags">
          <span>{story.data.kicker}</span>
          {story.data.editionStatus ? <span>{story.data.editionStatus}</span> : null}
          <span>{copy[story.data.desk]}</span>
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
      {
        story.data.claims.length ? (
          <section>
            <h2>{copy.claims}</h2>
            {story.data.claims.map((claim) => (
              <div class="claim-row">
                <ClaimLabel lang={lang} label={claim.label} />
                <p>
                  <code>{claim.id}</code> — {claim.text}
                </p>
              </div>
            ))}
          </section>
        ) : null
      }
      {
        story.data.sources.length ? (
          <section>
            <h2>{copy.sources}</h2>
            {story.data.sources.map((source) => (
              <SourceCard lang={lang} {...source} />
            ))}
          </section>
        ) : null
      }
      <section>
        <h2>{copy.correctionPath}</h2>
        <p>{copy.correctionPathDek}</p>
        <p>
          <a href={localize(lang, '/corrections')}>{copy.corrections} →</a>
        </p>
        {
          story.data.correctionLog.length ? (
            <ul>
              {story.data.correctionLog.map((row) => (
                <li>
                  <time>{row.date}</time> — {row.text}
                </li>
              ))}
            </ul>
          ) : null
        }
      </section>
    </article>
    <aside class="rail-box">
      <h2>{copy.latest}</h2>
      <ul class="index-list">
        {
          related.map((item) => (
            <li>
              <div class="kicker">{copy[item.data.desk]}</div>
              <h3>
                <a href={localize(lang, `/article/${storySlug(item)}`)}>{item.data.title}</a>
              </h3>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</BaseLayout>
