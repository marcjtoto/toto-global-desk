---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreakingBar from '../../components/BreakingBar.astro';
import { t } from '../../i18n/ui';
import { langFromParam, localize, staticLangPaths, withBase } from '../../lib/lang';
import { artForDesk, casesFor, homepageSlots, storiesFor, storyHero, storySlug, caseSlug } from '../../lib/content';

export function getStaticPaths() {
  return staticLangPaths();
}

const lang = langFromParam(Astro.params.lang);
const copy = t(lang);
const stories = await storiesFor(lang);
const cases = await casesFor(lang);
const { lead, breaking, mid, live, mostRead } = homepageSlots(stories);
const caseFile = cases.find((c) => c.data.status !== 'demo') ?? null;
const midA = mid[0];
const midB = mid[1];
const leadHero = lead ? storyHero(lead) : null;
const midAHero = midA ? storyHero(midA) : null;
const midBHero = midB ? storyHero(midB) : null;
---

<BaseLayout lang={lang} title={copy.tagline} description={copy.tagline}>
  {
    breaking ? (
      <BreakingBar
        lang={lang}
        title={breaking.data.title}
        href={localize(lang, `/article/${storySlug(breaking)}`)}
      />
    ) : null
  }
  <div class="wrap">
    <section class="home-board">
      {
        lead ? (
          <article class="lead">
            <p class="kicker">{copy.investigations}</p>
            <a href={localize(lang, `/article/${storySlug(lead)}`)}>
              <img
                class="lead-photo"
                src={withBase(leadHero.src)}
                alt={leadHero.alt}
                width="1200"
                height="720"
              />
            </a>
            {
              leadHero.caption ? (
                <p class="photo-cap">
                  {leadHero.caption}
                  <span class="credit">
                    {leadHero.credit} · {leadHero.rights}
                  </span>
                </p>
              ) : null
            }
            <h1>
              <a href={localize(lang, `/article/${storySlug(lead)}`)}>{lead.data.title}</a>
            </h1>
            <p class="dek">{lead.data.dek}</p>
            <p class="tags">
              <span>{copy.evidence}</span>
              <span>{lead.data.kicker}</span>
              <span>{copy[lead.data.desk]}</span>
            </p>
            <p class="byline">
              {copy.authors} {lead.data.authors.join(', ')} · {lead.data.published.toISOString().slice(0, 10)}
            </p>
          </article>
        ) : null
      }

      <div class="mid-stack">
        {
          midA ? (
            <article class="mid-card">
              <a href={localize(lang, `/article/${storySlug(midA)}`)}>
                <img
                  class="mid-photo"
                  src={withBase(midAHero.src)}
                  alt={midAHero.alt}
                  width="800"
                  height="480"
                />
              </a>
              {
                midAHero.caption ? (
                  <p class="photo-cap">
                    {midAHero.caption}
                    <span class="credit">
                      {midAHero.credit} · {midAHero.rights}
                    </span>
                  </p>
                ) : null
              }
              <span class="chip">{copy[midA.data.desk]}</span>
              <h2>
                <a href={localize(lang, `/article/${storySlug(midA)}`)}>{midA.data.title}</a>
              </h2>
              <p class="dek">{midA.data.dek}</p>
              <p class="byline">
                {copy.authors} {midA.data.authors.join(', ')} · {midA.data.published.toISOString().slice(0, 10)}
              </p>
            </article>
          ) : null
        }
        {
          midB ? (
            <article class="mid-card">
              <a href={localize(lang, `/article/${storySlug(midB)}`)}>
                <img
                  class="mid-photo"
                  src={withBase(midBHero.src)}
                  alt={midBHero.alt}
                  width="800"
                  height="420"
                />
              </a>
              {
                midBHero.caption ? (
                  <p class="photo-cap">
                    {midBHero.caption}
                    <span class="credit">
                      {midBHero.credit} · {midBHero.rights}
                    </span>
                  </p>
                ) : null
              }
              <span class="chip">{copy[midB.data.desk]}</span>
              <h2>
                <a href={localize(lang, `/article/${storySlug(midB)}`)}>{midB.data.title}</a>
              </h2>
              <p class="dek">{midB.data.dek}</p>
              <p class="byline">
                {copy.authors} {midB.data.authors.join(', ')} · {midB.data.published.toISOString().slice(0, 10)}
              </p>
            </article>
          ) : null
        }
      </div>

      <aside>
        <div class="live">
          <h2>{copy.liveUpdates}</h2>
          <ol>
            {
              live.map((story) => (
                <li>
                  <time datetime={story.data.published.toISOString()}>
                    {story.data.published.toISOString().slice(5, 10)}
                  </time>
                  <div>
                    <a href={localize(lang, `/article/${storySlug(story)}`)}>{story.data.title}</a>
                    {story.data.breaking ? <div class="now">{copy.now}</div> : null}
                  </div>
                </li>
              ))
            }
          </ol>
          <p style="padding:0 0.8rem 0.8rem">
            <a href={localize(lang, '/latest')}>{copy.seeAllUpdates} →</a>
          </p>
        </div>
        <div class="datalab">
          <h3>{copy['data-lab']}</h3>
          <img src={withBase('/art/map.svg')} alt={copy.originalArt} width="400" height="220" />
          <p class="dek">{copy.emptyDataLab}</p>
        </div>
      </aside>
    </section>

    <section class="strip">
      <div>
        <h3>{copy.briefing}</h3>
        <p>{copy.briefingDek}</p>
        {lead ? <a href={localize(lang, `/article/${storySlug(lead)}`)}>{copy.briefingCta} →</a> : null}
      </div>
      <div>
        <h3>{copy.spotlight}</h3>
        <img src={withBase('/art/confidential.svg')} alt={copy.originalArt} width="200" height="200" />
        {
          caseFile ? (
            <>
              <p>{copy.spotlightDek}</p>
              <a href={localize(lang, `/investigations/${caseSlug(caseFile)}`)}>{copy.spotlightCta} →</a>
            </>
          ) : (
            <p>{copy.emptySpotlight}</p>
          )
        }
      </div>
      <div>
        <h3>
          {copy.brasilUsa} <span class="flags">🇺🇸🇧🇷</span>
        </h3>
        <p>{copy.brasilUsaDek}</p>
        <a href={localize(lang, '/usa')}>{copy.compareCta} →</a>
      </div>
      <div>
        <h3>{copy.video}</h3>
        <img src={withBase('/art/video.svg')} alt={copy.originalArt} width="640" height="360" />
        <p>{copy.emptyVideo}</p>
      </div>
      <div>
        <h3>{copy.mostRead}</h3>
        <ol class="most-read">
          {
            mostRead.map((story) =>
              story ? (
                <li>
                  <a href={localize(lang, `/article/${storySlug(story)}`)}>{story.data.title}</a>
                </li>
              ) : null,
            )
          }
        </ol>
      </div>
    </section>
  </div>
</BaseLayout>
