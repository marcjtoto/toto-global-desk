---
import { t, type Lang } from '../i18n/ui';
import { localize } from '../lib/lang';

const { lang } = Astro.props as { lang: Lang };
const copy = t(lang);
const links = [
  ['/methodology', copy.methodology],
  ['/corrections', copy.corrections],
  ['/contact', copy.contact],
  ['/about', copy.about],
  ['/search', copy.search],
] as const;
---

<footer class="site-footer">
  <div class="wrap">
    <nav class="footer-nav">
      {links.map(([path, label]) => <a href={localize(lang, path)}>{label}</a>)}
    </nav>
    <p>{copy.footer}</p>
  </div>
</footer>
