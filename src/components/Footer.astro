---
import { desks, t, type Lang } from '../i18n/ui';
import { localize } from '../lib/lang';

const { lang } = Astro.props as { lang: Lang };
const copy = t(lang);
const links = [
  ['/methodology', copy.methodology],
  ['/corrections', copy.corrections],
  ['/contact', copy.contact],
  ['/about', copy.about],
  ['/search', copy.search],
  ['/rss.xml', 'RSS'],
] as const;
---

<footer class="site-footer">
  <div class="wrap">
    <nav class="footer-nav">
      {desks.map((desk) => (
        <a href={localize(lang, desk.path)}>{copy[desk.id]}</a>
      ))}
    </nav>
    <nav class="footer-nav">
      {links.map(([path, label]) => (
        <a href={localize(lang, path)}>{label}</a>
      ))}
    </nav>
    <p>{copy.footer}</p>
  </div>
</footer>
