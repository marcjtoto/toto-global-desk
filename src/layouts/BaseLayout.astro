---
import '../styles/global.css';
import { t, type Lang } from '../i18n/ui';
import { localize, switchLang, withBase } from '../lib/lang';
import DemoBanner from '../components/DemoBanner.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const { lang, title, description, ogType = 'website' } = Astro.props;
const copy = t(lang);
const pageTitle = `${title} — ${copy.name}`;
const desc = description ?? copy.tagline;
const origin = Astro.site ?? 'http://127.0.0.1:4321';
const canonical = new URL(Astro.url.pathname, origin).toString();
const hrefEn = new URL(switchLang(lang, 'en', Astro.url.pathname), origin).toString();
const hrefPt = new URL(switchLang(lang, 'pt-br', Astro.url.pathname), origin).toString();
const homeUrl = new URL(localize(lang, '/'), origin).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: copy.name,
      url: homeUrl,
      description: copy.demoBanner,
    },
    {
      '@type': 'WebSite',
      name: copy.name,
      url: homeUrl,
      inLanguage: lang === 'pt-br' ? 'pt-BR' : 'en',
      description: copy.tagline,
    },
  ],
};
---

<!doctype html>
<html lang={lang === 'pt-br' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={desc} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={copy.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'pt-br' ? 'pt_BR' : 'en_US'} />
    <link rel="alternate" hreflang="en" href={hrefEn} />
    <link rel="alternate" hreflang="pt-BR" href={hrefPt} />
    <link rel="alternate" hreflang="x-default" href={hrefEn} />
    <meta name="theme-color" content="#f6f1e8" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={localize(lang, '/rss.xml')} />
    <link rel="alternate" type="application/feed+json" title="JSON Feed" href={localize(lang, '/feed.json')} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('tgd-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{copy.skip}</a>
    <DemoBanner lang={lang} />
    <Masthead lang={lang} pathname={Astro.url.pathname} />
    <main id="content">
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      document.querySelectorAll('[data-theme-btn]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var next = btn.getAttribute('data-theme-btn');
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('tgd-theme', next);
          } catch (e) {}
        });
      });
    </script>
  </body>
</html>
