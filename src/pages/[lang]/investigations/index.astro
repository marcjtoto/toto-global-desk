---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/ui';
import { langFromParam, localize, staticLangPaths } from '../../../lib/lang';
import { casesFor, caseSlug, storiesFor, storySlug } from '../../../lib/content';

export function getStaticPaths() {
  return staticLangPaths();
}

const lang = langFromParam(Astro.params.lang);
const copy = t(lang);
const cases = await casesFor(lang);
const probes = (await storiesFor(lang)).filter((s) => s.data.desk === 'investigations');
---

<BaseLayout lang={lang} title={copy.investigations}>
  <div class="wrap">
    <header class="page-title">
      <p class="kicker">{copy.demoKicker}</p>
      <h1>{copy.investigations}</h1>
      <p class="dek">{copy.tagline}</p>
    </header>
    <ul class="index-list">
      {
        cases.map((item) => (
          <li>
            <div class="kicker">
              {item.data.kicker} · {item.data.publicationStatus}
            </div>
            <h2>
              <a href={localize(lang, `/investigations/${caseSlug(item)}`)}>{item.data.title}</a>
            </h2>
            <p class="dek">{item.data.centralQuestion}</p>
          </li>
        ))
      }
      {
        probes.map((story) => (
          <li>
            <div class="kicker">
              {story.data.kicker} · {copy[story.data.desk]}
            </div>
            <h2>
              <a href={localize(lang, `/article/${storySlug(story)}`)}>{story.data.title}</a>
            </h2>
            <p class="dek">{story.data.dek}</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
